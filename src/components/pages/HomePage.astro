---
import Base from "../../layouts/Base.astro";
import { pathFor, t, type Lang } from "../../i18n";
import { entriesFor } from "../../lib/entries";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const empty = {
  actions: (await entriesFor("actions", lang)).length === 0,
  news: (await entriesFor("news", lang)).length === 0,
};
const links = ["about", "whatWeDo", "actions", "news", "contact"] as const;
const text = (p: (typeof links)[number]) =>
  (p === "actions" || p === "news") && empty[p] ? d.sections.underConstructionShort : d.home.links[p];
---

<Base lang={lang} page="home">
  <section class="hero">
    <h1 class="hero-title">REMEDY FOR ALL</h1>
    <p class="lead">{d.purposeSentence}</p>
  </section>
  <ul class="cards">
    {
      links.map((p) => (
        <li class="card">
          <a href={pathFor(lang, p)}>{d.pages[p].title}</a>
          <p>{text(p)}</p>
        </li>
      ))
    }
  </ul>
</Base>
