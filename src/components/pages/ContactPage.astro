---
import Base from "../../layouts/Base.astro";
import Icon from "../Icon.astro";
import MarkedText from "../MarkedText.astro";
import { t, type Lang } from "../../i18n";
import { contactRows } from "../../lib/contact";
import { CONTACT } from "../../../site.config.mjs";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const icons = { email: "mail", phone: "phone", address: "map-pin" } as const;
// Only fields with a real value get a row; a placeholder is not shown at all.
const rows = contactRows(CONTACT).map((row) => ({
  ...row,
  label: d.contact.labels[row.field],
  icon: icons[row.field],
}));
---

<Base lang={lang} page="contact">
  <h1><MarkedText text={d.pages.contact.title} /></h1>
  <dl class="facts contact-fields card framed">
    {
      rows.map((row) => (
        <div>
          <dt>
            <Icon name={row.icon} />
            {row.label}
          </dt>
          <dd>{row.href ? <a href={row.href}>{row.text}</a> : row.text}</dd>
        </div>
      ))
    }
  </dl>
</Base>
