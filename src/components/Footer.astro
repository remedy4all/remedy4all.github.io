---
import LangSwitch from "./LangSwitch.astro";
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /** The same page in the other language, for the switch. */
  switchHref: string;
}

const { lang, switchHref } = Astro.props;
const d = t(lang);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-identity">
      <img class="footer-logo" src="/brand/remedy-logo-dark.png" width="850" height="311" alt="" />
      <p class="legal">{d.footer.legal[0]}<br />{d.footer.legal[1]}</p>
    </div>
    <div class="footer-side">
      <p class="credit">
        <span>{d.footer.supportedBy}</span>
        <a href="https://www.csl.gr">
          <span class="logo-chip"><img src="/brand/cssa-logo.png" width="703" height="170" alt="" /></span>
          <span>Computer Solutions S.A.</span>
        </a>
      </p>
      <LangSwitch lang={lang} href={switchHref} />
    </div>
  </div>
</footer>
