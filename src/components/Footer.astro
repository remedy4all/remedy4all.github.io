---
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<footer class="site-footer">
  <div class="footer-band">
    <div class="container footer-inner">
      <img class="footer-logo" src="/brand/remedy-logo-dark.png" width="850" height="311" alt="" />
      <p>{d.footer.legal}</p>
    </div>
  </div>
  <div class="footer-credit">
    <div class="container">
      <p class="credit">
        <span>{d.footer.supportedBy}</span>
        <a href="https://www.csl.gr">
          <img src="/brand/cssa-logo.png" width="703" height="170" alt="" />
          <span>Computer Solutions S.A.</span>
        </a>
      </p>
    </div>
  </div>
</footer>
