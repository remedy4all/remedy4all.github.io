---
import { PAGES, otherLang, pathFor, t, type Lang, type PageKey } from "../i18n";

interface Props {
  lang: Lang;
  page: PageKey;
  /** On an entry page the section link is current, but is not the page itself. */
  inEntry?: boolean;
}

const { lang, page, inEntry = false } = Astro.props;
const d = t(lang);
const other = otherLang(lang);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={pathFor(lang, "home")}>
      <img src="/brand/remedy-logo-light.png" width="737" height="391" alt="Remedy for All" />
    </a>
    <nav aria-label={d.navLabel}>
      <ul class="nav-list">
        {
          PAGES.map((p) => (
            <li>
              <a href={pathFor(lang, p)} aria-current={p === page ? (inEntry ? "true" : "page") : undefined}>
                {d.pages[p].title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="lang-switch" role="group" aria-label={d.switchLabel}>
      <a href={pathFor(other, page)} lang={other} hreflang={other}>{t(other).languageName}</a>
    </div>
  </div>
</header>
