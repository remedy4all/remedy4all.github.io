---
import LangSwitch from "./LangSwitch.astro";
import { PAGES, pathFor, t, type Lang, type PageKey } from "../i18n";

interface Props {
  lang: Lang;
  page: PageKey;
  /** The same page in the other language, for the switch. */
  switchHref: string;
  /** On an entry page the section link is current, but is not the page itself. */
  inEntry?: boolean;
}

const { lang, page, switchHref, inEntry = false } = Astro.props;
const d = t(lang);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={pathFor(lang, "home")}>
      <img src="/brand/remedy-logo-light-header.png" width="737" height="259" alt="Remedy for All" />
    </a>
    <LangSwitch lang={lang} href={switchHref} />
    <nav aria-label={d.navLabel}>
      <ul class="nav-list">
        {
          PAGES.map((p) => (
            <li>
              <a href={pathFor(lang, p)} aria-current={p === page ? (inEntry ? "true" : "page") : undefined}>
                {d.pages[p].title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
