---
import Icon from "./Icon.astro";
import Motif from "./Motif.astro";
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="uc-note card framed">
  <div class="card-media"><Icon name="construction" /></div>
  <p class="under-construction">{t(lang).sections.underConstruction}</p>
  <Motif edge="inline" />
</div>
