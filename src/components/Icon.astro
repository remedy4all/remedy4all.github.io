---
// Lucide line icons (ISC, src/icons/LICENSE), inlined so they take the text colour.
import type { IconName } from "../i18n/types";

interface Props {
  name: IconName;
}

const icons = import.meta.glob<string>("../icons/*.svg", { query: "?raw", import: "default", eager: true });
const svg = icons[`../icons/${Astro.props.name}.svg`];
if (!svg) throw new Error(`Unknown icon: ${Astro.props.name}`);
const html = svg.replace("<svg", '<svg aria-hidden="true" focusable="false"');
---

<span class="icon"><Fragment set:html={html} /></span>
