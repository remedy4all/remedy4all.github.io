---
// Renders "[...]" in a heading string as the pale-blue marker highlight. Without brackets, the
// whole text is marked.
interface Props {
  text: string;
}

const text = Astro.props.text.includes("[") ? Astro.props.text : `[${Astro.props.text}]`;
const parts = text.split(/(\[[^\]]+\])/).filter(Boolean);
---

{parts.map((part) => (part.startsWith("[") ? <span class="marker">{part.slice(1, -1)}</span> : part))}
