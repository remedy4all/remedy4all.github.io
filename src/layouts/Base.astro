---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { LANGS, pathFor, t, type Lang, type PageKey } from "../i18n";

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const d = t(lang);
const meta = d.pages[page];
const title = page === "home" ? "REMEDY FOR ALL" : `${meta.title} | REMEDY FOR ALL`;
const canonical = new URL(pathFor(lang, page), Astro.site).href;
const ogImage = new URL("/brand/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l, page), Astro.site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor("el", page), Astro.site).href} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/noto-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="REMEDY FOR ALL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={d.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.ogImageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.skipToContent}</a>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer lang={lang} />
  </body>
</html>
