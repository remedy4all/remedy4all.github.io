---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Motif from "../components/Motif.astro";
import Shape from "../components/Shape.astro";
import { LANGS, otherLang, pathFor, t, type Lang, type PageKey } from "../i18n";

interface Props {
  lang: Lang;
  page: PageKey;
  /** Set on an actions or news entry page: its own title, description and path. */
  entry?: { title: string; description: string; path: string };
  /** The page supplies its own `section.band` blocks; otherwise its content is one band. */
  bands?: boolean;
}

const { lang, page, entry, bands = false } = Astro.props;
// An entry exists in one language only, so its switch leads to the other language's section page.
const switchHref = pathFor(otherLang(lang), page);
const d = t(lang);
const meta = entry ?? d.pages[page];
const title = page === "home" && !entry ? "REMEDY FOR ALL" : `${meta.title} | REMEDY FOR ALL`;
const canonical = new URL(entry?.path ?? pathFor(lang, page), Astro.site).href;
const ogImage = new URL("/brand/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    {
      !entry && (
        <>
          {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l, page), Astro.site).href} />)}
          <link rel="alternate" hreflang="x-default" href={new URL(pathFor("el", page), Astro.site).href} />
        </>
      )
    }
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/noto-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="REMEDY FOR ALL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={d.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.ogImageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.skipToContent}</a>
    <div id="top-sentinel" aria-hidden="true"></div>
    <Header lang={lang} page={page} switchHref={switchHref} inEntry={Boolean(entry)} />
    <main id="main" tabindex="-1">
      {
        bands ? (
          <slot />
        ) : (
          <section class="band">
            <Shape corner="top-right" />
            <div class="container narrow">
              <slot />
            </div>
            <Motif edge="bottom" side="right" />
          </section>
        )
      }
    </main>
    <Footer lang={lang} switchHref={switchHref} />
    <script is:inline>
      // Compact header once the page is scrolled. Without this, the header is still sticky.
      (() => {
        const header = document.querySelector(".site-header");
        const sentinel = document.getElementById("top-sentinel");
        if (!header || !sentinel || !("IntersectionObserver" in window)) return;
        new IntersectionObserver(([e]) => header.classList.toggle("is-compact", !e.isIntersecting)).observe(sentinel);
      })();
    </script>
  </body>
</html>
